# PulseCoach — sunucu ortam değişkenleri (Vercel → Settings → Environment Variables)
# Hiçbiri NEXT_PUBLIC_ ile başlamaz: hepsi yalnız sunucuda okunur, tarayıcıya inmez.

# GitHub kullanıcı adın (uygulama ve danışan repolarının sahibi)
GITHUB_OWNER=

# Uygulama repo'sunun adı (kişisel veri içermez)
APP_REPO=pulsecoach

# Danışan repolarını oluşturup silebilen token. Yalnız bu iş için üret, süreli olsun.
# Uygulama sadece "client-" ile başlayan repolara dokunur (SPEC §9.2).
GITHUB_TOKEN=

# GitHub ile giriş (PT'nin giriş yöntemi)
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Authorization callback URL: https://<alan-adin>/api/giris/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Oturum çerezlerini imzalayan sır: openssl rand -base64 32
AUTH_SECRET=

# YEDEK giriş yolu (isteğe bağlı): e-posta kodu. Boş bırakılırsa bu yol kapalıdır.
# Amacı, OAuth ayarı bozulursa uygulamana girememe durumuna düşmemek.
PT_EMAIL=
RESEND_API_KEY=
